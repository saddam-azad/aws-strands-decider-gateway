# Environment for the local development loop.
#
#   cp .env.example .env
#
# Nothing here is read by the deployed Lambda: the stacks set their own environment (see
# lib/stack.ts), and a deployed function never loads this file. These variables are for
# `bun run dev`, `bun run setup` and the scripts, which run on your machine.
#
# There are no secrets in this file, and there should never be. The gateway's SigV4 signing
# uses the Lambda execution role in the cloud and your normal AWS credentials locally; tenant
# API keys are written to client/config.json and loadtest/config.json by `bun run setup`, both
# gitignored.

# ---------------------------------------------------------------- the dev loop (bun run dev)

# Where the model is. `bun run dev` starts a fake one and sets this for you; set it by hand
# to point at a real checkpoint (bun run model:local).
# DECIDER_URL=http://127.0.0.1:8080
# DECIDER_PATH=/v1/systemone
# DECIDER_TIMEOUT_MS=45000
# DECIDER_RETRIES=2

# `none` skips SigV4 signing, for a local fake that has no IAM to check. The dev server
# defaults to this; the deployed stack never sets it, so production always signs.
# DECIDER_AUTH=none

# The two ports the dev loop binds.
# PORT=3000
# MODEL_PORT=8080

# Which tenant and key the dev server accepts. The key is deliberately a fixed, fake-looking
# string: it lands in shell history all day, and a realistic one invites reuse.
# DEV_API_KEY=dev
# DEV_TENANT=acme
# DEV_APP=support

# Set to `false` to run the API without serving the web client, to check a client-side change
# did not break the JSON path.
# SERVE_CLIENT=true

# ------------------------------------------------------------------------- AWS (setup, e2e)

# `bun run setup` and `bun run e2e` talk to a real account. Your usual AWS credentials apply;
# set these when you have several profiles or regions in play.
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# The stack to read outputs from, if you renamed it.
# STACK_NAME=StrandsDecider

# Where the e2e test reads the gateway URL and keys from, if not loadtest/config.json.
# GATEWAY_CONFIG=loadtest/config.json
